    <ui:VisualElement name="Base" class="baseBody" style="flex-grow: 1; align-items: center; align-self: auto; opacity: 0.99;">
        <ui:VisualElement name="NarrowbandBorder" style="flex-grow: 0; align-self: center; align-items: center; justify-content: center; min-height: 385px; background-color: rgba(0, 0, 0, 0.67); border-left-color: rgb(168, 0, 0); border-right-color: rgb(168, 0, 0); border-top-color: rgb(168, 0, 0); border-bottom-color: rgb(168, 0, 0); border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px; border-left-width: 3px; border-top-left-radius: 1px; border-top-right-radius: 1px; border-bottom-right-radius: 1px; border-bottom-left-radius: 1px; min-width: 500px; top: 10%;"/>
