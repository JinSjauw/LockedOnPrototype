        <ui:Slider label="Slider" value="0" high-value="100" name="SelectionSlider" show-input-field="false" direction="Horizontal" low-value="-100" fill="false" class="selectorSlider" style="top: 12%; min-width: 72%; align-content: center; align-self: center; justify-content: center; min-height: 5%;"/>
