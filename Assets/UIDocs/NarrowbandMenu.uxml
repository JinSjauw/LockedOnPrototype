            <ui:VisualElement name="Info" style="flex-grow: 1; min-width: 40%; min-height: 100%; display: flex; opacity: 1; align-self: center; background-color: rgb(11, 2, 2); border-left-color: rgb(168, 0, 0); border-right-color: rgb(168, 0, 0); border-top-color: rgb(168, 0, 0); border-bottom-color: rgb(168, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; align-content: center; align-items: center; justify-content: center; top: -28%; left: -11%;"/>
