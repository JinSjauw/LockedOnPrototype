:root {
}

.panel {
    background-color: rgb(46, 14, 15);
    align-self: center;
    align-items: center;
    justify-content: center;
    align-content: center;
    flex-grow: 1;
}

.menu {
    width: 30%;
    max-height: 75%;
    align-self: center;
    align-content: center;
    justify-content: center;
    align-items: center;
}

.unity-button {
    align-items: center;
    flex-grow: 0;
    align-self: center;
    align-content: center;
    min-width: 65%;
    border-left-color: rgba(180, 9, 9, 0.89);
    border-right-color: rgba(180, 9, 9, 0.89);
    border-top-color: rgba(180, 9, 9, 0.89);
    border-bottom-color: rgba(180, 9, 9, 0.89);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    min-height: 14%;
    height: auto;
    justify-content: flex-start;
    margin-top: 10px;
    margin-right: 10px;
    margin-bottom: 10px;
    margin-left: 10px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    -unity-font-style: normal;
}

.unity-text-element {
    background-color: rgb(231, 96, 90);
    font-size: 265%;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Packages/com.unity.render-pipelines.core/Runtime/Debugging/Prefabs/Fonts/PerfectDOSVGA437.ttf?fileID=12800000&guid=74a5091d8707f334b9a5c31ef71a64ba&type=3#PerfectDOSVGA437");
}

.unity-label {
    align-self: center;
    min-width: 85%;
    min-height: 20%;
    margin-bottom: 92px;
    max-height: 25%;
    max-width: 85%;
}

.unity-button:hover {
    background-color: rgb(31, 15, 15);
    color: rgb(0, 0, 0);
    -unity-text-outline-color: rgb(255, 0, 0);
    -unity-text-outline-width: 2px;
    scale: 0.95 0.85 0.95;
    transition-property: scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-in-out-circ;
}


